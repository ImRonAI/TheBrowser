+def _agent(node_id: str, label: str, skill: str, description: str) -> dict[str, Any]:
+    """One formation agent: ``skill`` is its SKILL.md and ``description`` its role in the formation."""
+    return {
+        "id": node_id,
+        "label": label,
+        "kind": "agent",
+        "skill": skill,
+        "description": description,
+        "children": [],
+        "edges": [],
+    }
+
