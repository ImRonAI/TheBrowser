+def _revise(qa_id: str, agent_id: str) -> dict[str, Any]:
+    """A QA feedback edge: followed while the QA agent's verdict is ``REVISE: <agent_id>``."""
+    return {
+        "from": qa_id,
+        "to": agent_id,
+        "conditional": True,
+        "label": "QA sends it back",
+        "condition": f"REVISE: {agent_id}",
+    }
