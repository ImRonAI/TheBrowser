+def test_barge_in_closes_deferred_response_and_next_reply_is_distinct(model, live_message, server_content, status):
+    """An interruption ends the deferred response; the reply to the new input opens a new response."""
+    turn_state = _TurnState(response_id="r1", completion_deferred=True)
