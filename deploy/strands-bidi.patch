+def test_turn_complete_in_progress_defers_response_stop_until_idle(model, live_message, server_content):
+    """Extended thinking: each utterance's content closes with its turn; only the response stays open until IDLE."""
+    turn_state = _TurnState()
+    convert = lambda **fields: model._convert_gemini_live_event(  # noqa: E731
+        live_message(**fields), turn_state
+    )
+
+    speaking = convert(
+        data=b"audio",
+        server_content=server_content(output_transcription=genai_types.Transcription(text="Checking")),
+    )
+    response_id = speaking[0].response_id
+    transcript_id = speaking[1].content_id
+    audio_id = speaking[3].content_id
+
+    tru_turn_done = convert(
+        server_content=server_content(turn_complete=True, interaction_status=genai_types.InteractionStatus.IN_PROGRESS)
+    )
+    exp_turn_done = [
+        BidiInteractionStatusEvent("in_progress", turn_complete=True),
+        BidiAudioStopEvent(audio_id),
+        BidiTranscriptStopEvent("assistant", content_id=transcript_id),
+    ]
+    assert tru_turn_done == exp_turn_done
+    assert turn_state.response_id == response_id
+    assert turn_state.output_transcript_id is None
+    assert turn_state.completion_deferred is True
+
+    # Follow-up speech while still in progress belongs to the same response but a new transcript.
+    tru_more = convert(
+        data=b"more",
+        server_content=server_content(output_transcription=genai_types.Transcription(text="blueberry")),
+    )
+    second_transcript_id = tru_more[0].content_id
+    assert second_transcript_id != transcript_id
+    assert tru_more == [
+        BidiTranscriptStartEvent("assistant", content_id=second_transcript_id),
+        BidiTranscriptDeltaEvent("blueberry", "assistant", content_id=second_transcript_id),
+        BidiAudioStartEvent(unittest.mock.ANY),
+        BidiAudioDeltaEvent(
+            audio=base64.b64encode(b"more").decode(),
+            format="pcm",
+            sample_rate=24000,
+            channels=1,
+            content_id=unittest.mock.ANY,
+        ),
+    ]
+    assert turn_state.response_id == response_id
+
+    tru_idle = convert(
+        server_content=server_content(turn_complete=True, interaction_status=genai_types.InteractionStatus.IDLE)
+    )
+    exp_idle = [
+        BidiInteractionStatusEvent("idle", turn_complete=True),
+        BidiAudioStopEvent(tru_more[2].content_id),
+        BidiTranscriptStopEvent("assistant", content_id=second_transcript_id),
+        BidiResponseStopEvent(response_id),
+    ]
+    assert tru_idle == exp_idle
+    assert turn_state.response_id is None
+    assert turn_state.completion_deferred is False
+
