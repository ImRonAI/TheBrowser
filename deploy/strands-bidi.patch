+@dataclass
+class RealtimeInput:
+    """Non-audio content appended to the live input stream.
+
+    Exactly one field is set per instance. Like ``AudioDelta``, realtime input is streamed into
+    the provider's live context without turn semantics: it does not end the user's turn, does not
+    interrupt an active response, and has no guaranteed ordering relative to other realtime input.
+    Providers without a live input stream reject it.
+
+    Attributes:
+        text: Text appended to the live input stream.
+        video: One video frame (an image) appended to the live input stream.
+        audio_stream_end: Signals that the audio input stream has ended.
+        activity: Manual voice-activity boundary.
+
+    Raises:
+        ValueError: If zero or several fields are set.
+    """
+
+    text: str | None = None
+    video: ImageContent | None = None
+    audio_stream_end: bool | None = None
+    activity: RealtimeActivity | None = None
+
+    def __post_init__(self) -> None:
+        """Enforce that exactly one field is set."""
+        if len(self.to_dict()["realtime_input"]) != 1:
+            raise ValueError("invalid realtime input | expected exactly one of text, video, audio_stream_end, activity")
+
+    def to_dict(self) -> _RealtimeInputData:
+        """Return the dictionary form of this input, carrying only the set field."""
+        content: RealtimeInputContent = {}
+        if self.text is not None:
+            content["text"] = self.text
+        if self.video is not None:
+            content["video"] = self.video
+        if self.audio_stream_end is not None:
+            content["audio_stream_end"] = self.audio_stream_end
+        if self.activity is not None:
+            content["activity"] = self.activity
+        return {"realtime_input": content}
+
