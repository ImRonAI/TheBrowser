# /etc/ronbrowser/ron.env template for Ron agent server (mode 640 root:ron).
# NEVER commit real tokens or credentials to version control.
# Seeded onto VPS by deploy/vps-bootstrap.sh; edit /etc/ronbrowser/ron.env on the server.
# Systemd EnvironmentFile format: plain KEY=value lines (no export, no quotes needed).

# Storage backend for sessions, run journals and long-term memory: 'huggingface' (production
# authority; required on the VPS) or 'memory' (ephemeral, local development only). In
# huggingface mode the API refuses to start without HF_TOKEN and creates the private bucket
# on first boot (HfApi.create_bucket exist_ok). There is no fallback to memory.
PANEL_STORAGE=huggingface
# HuggingFace bucket identifier ('namespace/bucket-name') for storage
HF_BUCKET_ID=IAMRonHIT/RonBrowserRebuildBucket
# HuggingFace user access token with write permission to HF_BUCKET_ID (required in huggingface mode)
HF_TOKEN=REPLACE_ME
# API key for Perplexity Sonar / Agent models catalogue and completions
PERPLEXITY_API_KEY=
# API key for OpenAI model provider
OPENAI_API_KEY=
# API key for Anthropic Claude model provider
ANTHROPIC_API_KEY=
# API key for Google Gemini AI Studio provider
GEMINI_API_KEY=
# Live Music (Lyria RealTime) for the Live agent's music_* tools; RON_LIVE_MUSIC=0 disables.
# RON_LIVE_MUSIC_MODEL=models/lyria-realtime-exp
# RON_LIVE_MUSIC_API_VERSION=v1beta
# RON_LIVE_MUSIC_RECORD_SECONDS=240
# RON_LIVE_MUSIC_MAX_UPLOAD_MB=50   (match the Supabase project/bucket file-size limit)
# RON_LIVE_MUSIC_BUCKET=music   (private Supabase Storage bucket; migration 012_songs.sql)
# Batch music generation (Lyria 3.5 via Interactions API uses GEMINI_API_KEY; ElevenLabs Music needs its key).
ELEVENLABS_API_KEY=
# RON_MUSIC_GENERATION=1
# RON_MUSIC_GENERATION_TIMEOUT=420
# API key for xAI Grok provider
XAI_API_KEY=
# API key for Mistral AI provider
MISTRAL_API_KEY=
# Brave Search API subscription token (Pro Data plan) for the Discover homepage feed. Backend-only; never expose as VITE_*
BRAVE_SEARCH_API_KEY=
# Host interface for FastAPI agent backend (use 127.0.0.1 for local loopback; accessed via SSH tunnel)
API_HOST=127.0.0.1
# Port for FastAPI agent backend
API_PORT=8765
# Comma-separated CORS allowed origins for renderer / web clients
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Default browser target selected on agent startup ('user' for local forwarded browser, 'cloud' for VPS headless)
RON_BROWSER_DEFAULT=user
# Electron automation endpoint URL for user's local browser forwarded via SSH reverse tunnel (:13000 -> Mac :3000)
RON_USER_BROWSER_ELECTRON_URL=http://127.0.0.1:13000/electron
# Playwright MCP endpoint URL for user's local browser forwarded via SSH reverse tunnel (:18931 -> Mac :8931)
RON_USER_BROWSER_PLAYWRIGHT_URL=http://127.0.0.1:18931/mcp
# Chrome DevTools Protocol URL for user's local browser forwarded via SSH reverse tunnel (:19222 -> Mac :9222)
RON_USER_BROWSER_CDP_URL=http://127.0.0.1:19222
# Electron automation endpoint URL for cloud headless browser on VPS
RON_CLOUD_BROWSER_ELECTRON_URL=http://127.0.0.1:3000/electron
# Playwright MCP endpoint URL for cloud headless browser on VPS
RON_CLOUD_BROWSER_PLAYWRIGHT_URL=http://127.0.0.1:8931/mcp
# Chrome DevTools Protocol URL for cloud headless browser on VPS
RON_CLOUD_BROWSER_CDP_URL=http://127.0.0.1:9222
# Read-idle watchdog for Perplexity Agent API SSE streams, seconds. A silent stream is retried by the native ModelRetryStrategy; 0 disables (a hung stream then needs user cancellation)
PERPLEXITY_READ_TIMEOUT=300
# Host tool consent: strands_tools shell/editor/environment/http_request ask "[y/*]" on stdin before
# mutating actions. The API has no TTY, so without the bypass those calls fail with "[Errno 22]".
# config.py sets BYPASS_TOOL_CONSENT=true by default; RON_TOOL_CONSENT=prompt keeps the prompts.
BYPASS_TOOL_CONSENT=true
# Memory: Perplexity Agent API model chain for the `recall` subagent; the first id is also the panel
# agent's aux_model, which runs the dreaming extraction. RON_MEMORY_AGENT=0 drops `recall`.
RON_MEMORY_AGENT_MODELS=google/gemini-3.5-flash-lite,openai/gpt-5.4-nano,perplexity/sonar,perplexity/nemotron-3-ultra-550b-a55b
RON_MEMORY_AGENT=1
# Tool observation (CAT-49): native OTel tool spans carry arguments/results under the latest GenAI
# conventions; RON_TOOL_OBSERVATION=1 retains spans in memory via strands-agents-evals for diagnosis.
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
RON_TOOL_OBSERVATION=0
# A2A: Ron's native Strands A2AServer is mounted at PANEL_A2A_URL (default this API's /a2a) and
# EVERY Ron agent (panel, Live, recall, fixer, issue agents, skill children) gets the strands_tools
# a2a_discover_agent / a2a_list_discovered_agents / a2a_send_message tools over it plus RON_A2A_AGENTS.
# PANEL_A2A_ENABLED=0 turns both off. Loopback only: never expose /a2a through ngrok.
PANEL_A2A_ENABLED=1
# PANEL_A2A_URL=http://127.0.0.1:8765/a2a
RON_A2A_AGENTS=
# Tool repair (CAT-50/51): per-user fixer proposed after RON_TOOL_REPAIR_THRESHOLD identical failures
# of a library tool in one session; verification runs in a sandbox (Docker code_interpreter or the
# Perplexity `sandbox` hosted tool). The fixer runs openai/gpt-6.1-sol at reasoning effort max
# (RON_TOOL_REPAIR_MODELS is a FallbackStrategy comma list). RON_TOOL_REPAIR=0 disables.
RON_TOOL_REPAIR=1
RON_TOOL_REPAIR_THRESHOLD=2
RON_TOOL_REPAIR_MODELS=openai/gpt-6.1-sol
RON_TOOL_REPAIR_EFFORT=max
RON_TOOL_REPAIR_TIMEOUT_S=900
# Server-side Perplexity Agent API tools on the fixer's model: built-ins (web_search, fetch_url,
# image_search, sandbox, finance_search, people_search), the managed GitHub connector
# (connector_github: connect it on console.perplexity.ai/project/connectors) and Context7's remote
# MCP server (context7; CONTEXT7_API_KEY is sent as the MCP `authorization`).
RON_TOOL_REPAIR_HOSTED_TOOLS=web_search,fetch_url,image_search,sandbox,connector_github,context7
CONTEXT7_MCP_URL=https://mcp.context7.com/mcp
CONTEXT7_API_KEY=
# Extra A2A peers for the fixer only (all agents already reach the panel A2A server + RON_A2A_AGENTS).
RON_TOOL_REPAIR_A2A_AGENTS=
# Local-only (NOT on the VPS): Postgres connection string from the Dashboard (Settings -> Database ->
# Connection string -> Direct) for deploy/apply-migrations.sh. DDL migrations cannot run over the REST API.
# SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
