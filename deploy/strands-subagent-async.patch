+"""Tests for programmatic_tool_caller under always=['*'] background_tasks and native hot_reload."""
+
+from __future__ import annotations
+
+import asyncio
+from pathlib import Path
+from typing import Any
+
+from strands import Agent, tool
+from strands.models import Model
+from strands_harness.tools.programmatic_tool_caller import make_programmatic_tool_caller
+
+
+def _assistant_tool(name: str, tool_use_id: str, tool_input: dict[str, Any]) -> list[dict[str, Any]]:
+    return [{"toolUse": {"name": name, "toolUseId": tool_use_id, "input": tool_input}}]
+
+
+def _assistant_text(text: str) -> list[dict[str, Any]]:
+    return [{"text": text}]
+
+
+class _ScriptedModel(Model):
+    """Minimal offline Strands Model returning scripted assistant turns."""
+
+    def __init__(self, turns: list[list[dict[str, Any]]]) -> None:
+        self._turns = list(turns)
+        self.calls = 0
+
+    def update_config(self, **model_config: Any) -> None:
+        pass
+
+    def get_config(self) -> dict[str, Any]:
+        return {}
+
+    async def structured_output(self, output_model: Any, prompt: Any, system_prompt: Any = None, **kwargs: Any):
+        if False:
+            yield
+
+    async def stream(
+        self,
+        messages: Any,
+        tool_specs: Any = None,
+        system_prompt: Any = None,
+        *,
+        tool_choice: Any = None,
+        **kwargs: Any,
+    ):
+        idx = min(self.calls, len(self._turns) - 1)
+        self.calls += 1
+        blocks = self._turns[idx]
+        yield {"messageStart": {"role": "assistant"}}
+        for i, block in enumerate(blocks):
+            if "text" in block:
+                yield {"contentBlockStart": {"contentBlockIndex": i, "start": {}}}
+                yield {"contentBlockDelta": {"contentBlockIndex": i, "delta": {"text": block["text"]}}}
+                yield {"contentBlockStop": {"contentBlockIndex": i}}
+            elif "toolUse" in block:
+                tu = block["toolUse"]
+                import json
+
+                yield {
+                    "contentBlockStart": {
+                        "contentBlockIndex": i,
+                        "start": {"toolUse": {"name": tu["name"], "toolUseId": tu["toolUseId"]}},
+                    }
+                }
+                yield {
+                    "contentBlockDelta": {
+                        "contentBlockIndex": i,
+                        "delta": {"toolUse": {"input": json.dumps(tu["input"])}},
+                    }
+                }
+                yield {"contentBlockStop": {"contentBlockIndex": i}}
+        stop_reason = "tool_use" if any("toolUse" in b for b in blocks) else "end_turn"
+        yield {"messageStop": {"stopReason": stop_reason}}
+
+
+async def test_programmatic_tool_caller_runs_async_while_inner_calls_run_inline_under_always_wildcard() -> None:
+    """Under background_tasks={'always': ['*']}, programmatic_tool_caller itself dispatches asynchronously
+    in the background while inner `await tool(...)` calls inside Monty execute inline and return real data."""
+
+    @tool
+    def compute_double(x: int) -> dict[str, Any]:
+        """Double x."""
+        return {"doubled": x * 2}
+
+    ptc = make_programmatic_tool_caller(hot_reload=True)
+    model = _ScriptedModel(
+        [
+            # Turn 1: model calls programmatic_tool_caller -> dispatched asynchronously (Task ID returned)
+            _assistant_tool(
+                "programmatic_tool_caller",
+                "ptc-1",
+                {"code": 'res = await compute_double(x=21)\nprint(res["doubled"])'},
+            ),
+            # Turn 2: model responds while background task runs -> wait_for_completion delivers result
+            _assistant_text("Dispatched orchestration."),
+            # Turn 3: model sees settled result '42'
+            _assistant_text("Final answer: 42"),
+        ]
+    )
+    agent = Agent(
+        model=model,
+        tools=[compute_double, ptc],
+        background_tasks={"always": ["*"], "wait_for_completion": True},
+        load_tools_from_directory=False,
+        callback_handler=None,
+    )
+
+    result = await agent.invoke_async("Double 21 via programmatic_tool_caller")
+    assert "42" in str(result)
+    all_tool_texts = [
+        c.get("text", "")
+        for m in agent.messages
+        for b in m.get("content", [])
+        if "toolResult" in b
+        for c in b["toolResult"].get("content", [])
+    ]
+    assert any("Background task dispatched" in t for t in all_tool_texts)
+    assert any(t.strip() == "42" for t in all_tool_texts)
+
+
+async def test_hot_reload_creates_and_calls_new_decorated_tool_in_same_monty_run(
+    tmp_path: Path, monkeypatch: Any
+) -> None:
+    """Writing a brand-new @tool Python file into ./tools/ hot-reloads via ToolWatcher / hot_reload sync
+    and is callable immediately via `await custom_tool(...)` inside the SAME programmatic_tool_caller run."""
+    monkeypatch.chdir(tmp_path)
+    tools_dir = tmp_path / "tools"
+    tools_dir.mkdir()
+
+    @tool
+    def write_tool_file(filename: str, source: str) -> str:
+        """Write a Python file inside ./tools/."""
+        target = tools_dir / filename
+        target.write_text(source, encoding="utf-8")
+        return str(target)
+
+    ptc = make_programmatic_tool_caller(hot_reload=True)
+    tool_source = (
+        "from strands import tool\n\n"
+        "@tool\n"
+        "def custom_rescuer(query: str) -> dict:\n"
+        '    """Fallback tool authored at runtime."""\n'
+        '    return {"rescued": query.upper()}\n'
+    )
+    code = (
+        f"await write_tool_file(filename='custom_rescuer.py', source={tool_source!r})\n"
+        "data = await custom_rescuer(query='olostep_recovered')\n"
+        "print(data['rescued'])\n"
+    )
+    model = _ScriptedModel(
+        [
+            _assistant_tool("programmatic_tool_caller", "ptc-hot", {"code": code}),
+            _assistant_text("Running hot-reload script."),
+            _assistant_text("Done: OLOSTEP_RECOVERED"),
+        ]
+    )
+    agent = Agent(
+        model=model,
+        tools=[write_tool_file, ptc],
+        background_tasks={"always": ["*"], "wait_for_completion": True},
+        load_tools_from_directory=True,
+        callback_handler=None,
+    )
+
+    result = await agent.invoke_async("Build custom_rescuer and run it")
+    assert "OLOSTEP_RECOVERED" in str(result)
+    assert "custom_rescuer" in agent.tool_registry.registry
+    all_tool_texts = [
+        c.get("text", "")
+        for m in agent.messages
+        for b in m.get("content", [])
+        if "toolResult" in b
+        for c in b["toolResult"].get("content", [])
+    ]
+    assert any(t.strip() == "OLOSTEP_RECOVERED" for t in all_tool_texts)
+
+    # Also verify ToolWatcher reloads an atomic file replacement on disk without programmatic_tool_caller
+    updated_source = (
+        "from strands import tool\n\n"
+        "@tool\n"
+        "def watcher_created(val: str) -> str:\n"
+        '    """Created for ToolWatcher on_moved test."""\n'
+        "    return f'watched:{val}'\n"
+    )
+    staging = tools_dir / ".watcher_created.tmp"
+    staging.write_text(updated_source, encoding="utf-8")
+    staging.replace(tools_dir / "watcher_created.py")
+    for _ in range(40):
+        if "watcher_created" in agent.tool_registry.registry:
+            break
+        await asyncio.sleep(0.05)
+    assert "watcher_created" in agent.tool_registry.registry
