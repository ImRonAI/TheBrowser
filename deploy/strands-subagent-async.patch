+@pytest.mark.asyncio
+async def test_create_harness_native_subagent_background_config_and_recovery() -> None:
+    """`create_harness(builtin_tools={'subagent': {'background': True, ...}})` wires the native
+    `strands_harness` subagent with async background execution, consecutive-error hangup wakeup, and recovery."""
+
+    @tool(name="flaky_tool")
+    def flaky_tool() -> dict[str, Any]:
+        """Always errors."""
+        return {"status": "error", "content": [{"text": "503 upstream unavailable"}]}
+
+    @tool(name="healthy_tool")
+    def healthy_tool() -> str:
+        """Succeeds."""
+        return "HEALTHY_RESULT_42"
+
+    def sub_or_parent_logic(messages, tool_specs, system_prompt):
+        spec_names = {s["name"] for s in (tool_specs or [])}
+        dump = json.dumps(messages)
+        # Child subagent (depth decremented -> still has tools, check prompt)
+        if "You are a general-purpose subagent" in (system_prompt or ""):
+            if "Switch to healthy_tool" in dump:
+                if "HEALTHY_RESULT_42" in dump:
+                    return _assistant_text("Child recovered with HEALTHY_RESULT_42")
+                return _assistant_tool("healthy_tool", "ht-1", {})
+            # Otherwise loop failing `flaky_tool` to trigger `max_consecutive_errors=2`!
+            idx = dump.count("503 upstream unavailable")
+            if idx < 2:
+                return _assistant_tool("flaky_tool", f"ft-{idx}", {})
+            # Stall slightly so parent catches consecutive_errors while running
+            return _assistant_tool("flaky_tool", f"ft-{idx}", {})
+
+        # Parent harness agent
+        assert "subagent" in spec_names
+        if "[subagent-completed]" in dump and "HEALTHY_RESULT_42" in dump:
+            return _assistant_text("Harness parent done: HEALTHY_RESULT_42")
+        if "[subagent-hangup]" in dump:
+            if '"recovered_from"' not in dump:
+                # Extract subagent_id from alert
+                last_txt = messages[-1]["content"][0]["text"]
+                json_part = json.loads(last_txt.split(":\n", 1)[1])
+                hung_id = json_part[0]["subagent_id"]
+                return _assistant_tool(
+                    "subagent",
+                    "p-rec",
+                    {"action": "recover", "subagent_id": hung_id, "task": "Switch to healthy_tool"},
+                )
+            return _assistant_text("Waiting for recovered harness subagent.")
+        if '"subagent_id"' not in dump:
+            return _assistant_tool("subagent", "p-spawn", {"task": "Fetch result"})
+        return _assistant_text("Waiting on initial harness subagent.")
+
+    slow_flaky_gate = asyncio.Event()
+
+    @tool(name="slow_after_errors")
+    async def slow_after_errors() -> str:
+        """Holds child running after consecutive errors."""
+        await slow_after_errors_wait()
+        return "done"
+
+    async def slow_after_errors_wait() -> None:
+        await slow_flaky_gate.wait()
+
+    def combined_logic(messages, tool_specs, system_prompt):
+        dump = json.dumps(messages)
+        if "You are a general-purpose subagent" in (system_prompt or ""):
+            if "Switch to healthy_tool" in dump:
+                if "HEALTHY_RESULT_42" in dump:
+                    return _assistant_text("Child recovered with HEALTHY_RESULT_42")
+                return _assistant_tool("healthy_tool", "ht-1", {})
+            err_count = dump.count("503 upstream unavailable")
+            if err_count < 2:
+                return _assistant_tool("flaky_tool", f"ft-{err_count}", {})
+            return _assistant_tool("slow_after_errors", "sae-1", {})
+        return sub_or_parent_logic(messages, tool_specs, system_prompt)
+
+    agent = create_harness(
+        model=CallbackDrivenModel(combined_logic),
+        tools=[flaky_tool, healthy_tool, slow_after_errors],
+        builtin_tools={"*": False, "subagent": {"background": True, "stall_timeout": 5.0, "max_consecutive_errors": 2}},
+        builtin_plugins=[],
+        caching=False,
+        session=False,
+        skills=False,
+        memory=False,
+        callback_handler=None,
+    )
+
+    out = await agent.invoke_async("Get healthy result.")
+    assert "Harness parent done: HEALTHY_RESULT_42" in str(out)
+
