+@pytest.mark.asyncio
+async def test_sdk_background_tasks_with_vended_subagent_interrupt_does_not_crash() -> None:
+    """When native `subagent` (`background=False`) runs inside `Agent(background_tasks={'always': [subagent]})`,
+    a child tool interrupt transitions cleanly to `stop_reason == 'interrupt'` instead of crashing with
+    `RuntimeError('Interrupt raised: ...')`."""
+
+    @tool(name="child_gate", context=True)
+    def child_gate(tool_context: ToolContext) -> str:
+        """Interrupts inside child."""
+        return f"approved:{tool_context.interrupt('gate', reason='Proceed?')}"
+
+    sub_tool = make_subagent(
+        builder=lambda spec: Agent(
+            model=MockedModelProvider([_assistant_tool("child_gate", "cg-1", {}), _assistant_text("Child done")]),
+            tools=[child_gate],
+            callback_handler=None,
+        ),
+    )
+
+    parent = Agent(
+        model=MockedModelProvider(
+            [
+                _assistant_tool("subagent", "s-1", {"task": "Run gated work"}),
+                _assistant_text("Waiting."),
+            ]
+        ),
+        tools=[sub_tool],
+        background_tasks={"always": [sub_tool]},
+        callback_handler=None,
+    )
+
+    res = await parent.invoke_async("Go")
+    assert res.stop_reason == "interrupt"
+    assert res.interrupts[0].name == "gate"
