@@ -0,0 +1,349 @@
+"""Tests for native async background execution and hangup recovery on the Strands Harness SDK `subagent` tool."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import threading
+import time
+from typing import Any
+
+import pytest
+
+from strands import Agent, ToolContext, tool
+from strands.multiagent.spec import Choice, Fixed, Preset
+from strands.vended_tools.subagent import make_subagent
+from strands_harness import create_harness
+from tests.fixtures.mocked_model_provider import MockedModelProvider
+
+
+def _assistant_text(text: str) -> dict[str, Any]:
+    return {"role": "assistant", "content": [{"text": text}]}
+
+
+def _assistant_tool(name: str, tool_use_id: str, tool_input: dict[str, Any]) -> dict[str, Any]:
+    return {"role": "assistant", "content": [{"toolUse": {"name": name, "toolUseId": tool_use_id, "input": tool_input}}]}
+
+
+class CallbackDrivenModel(MockedModelProvider):
+    """Deterministic MockedModelProvider subclass that computes each assistant reply dynamically from `messages`."""
+
+    def __init__(self, fn):
+        super().__init__([])
+        self._fn = fn
+
+    async def stream(self, messages, tool_specs=None, system_prompt=None, tool_choice=None, **kwargs):
+        reply = self._fn(messages, tool_specs, system_prompt)
+        if asyncio.iscoroutine(reply):
+            reply = await reply
+        for ev in self.map_agent_message_to_events(reply):
+            yield ev
+
+
+@pytest.mark.asyncio
+async def test_vended_subagent_background_spawn_and_midflight_steer() -> None:
+    """Native `strands.vended_tools.subagent.make_subagent(background=True)` runs async in the background
+    while the parent keeps working and steers the running child mid-flight without restarting it."""
+    timeline: list[str] = []
+    release_child = asyncio.Event()
+
+    @tool(name="child_step")
+    async def child_step() -> str:
+        """Child step 1."""
+        timeline.append("child:step1_started")
+        await release_child.wait()
+        return "RAW_REPO_INDEX_OK"
+
+    @tool(name="parent_step")
+    async def parent_step() -> str:
+        """Parent work while child runs."""
+        timeline.append("parent:parallel_work")
+        return "PARENT_LOCAL_DONE"
+
+    def child_logic(messages, _specs, _sys):
+        dump = json.dumps(messages)
+        if "RAW_REPO_INDEX_OK" not in dump:
+            return _assistant_tool("child_step", "cs-1", {})
+        assert "<parent-steering>" in dump and "Focus strictly on auth.py" in dump
+        timeline.append("child:applied_midflight_steering")
+        return _assistant_text("Child finished: focused strictly on auth.py")
+
+    sub_tool = make_subagent(
+        builder=lambda spec: Agent(
+            model=CallbackDrivenModel(child_logic),
+            system_prompt=spec.instructions or "",
+            tools=[child_step],
+            callback_handler=None,
+        ),
+        background=True,
+        stall_timeout=5.0,
+    )
+
+    sub_id: str | None = None
+    turn = 0
+
+    async def parent_logic(messages, _specs, _sys):
+        nonlocal turn, sub_id
+        turn += 1
+        if turn == 1:
+            return _assistant_tool("subagent", "p-1", {"task": "Index and audit repo"})
+        if turn == 2:
+            sub_id = messages[-1]["content"][0]["toolResult"]["content"][0]["json"]["subagent_id"]
+            return _assistant_tool("parent_step", "p-2", {})
+        if turn == 3:
+            # Inspect live status, then steer while child is still running!
+            return _assistant_tool("subagent", "p-3", {"action": "status", "subagent_id": sub_id})
+        if turn == 4:
+            status_json = messages[-1]["content"][0]["toolResult"]["content"][0]["json"]
+            assert status_json["status"] == "running"
+            return _assistant_tool(
+                "subagent",
+                "p-4",
+                {"action": "steer", "subagent_id": sub_id, "task": "Focus strictly on auth.py"},
+            )
+        if turn == 5:
+            release_child.set()
+            return _assistant_text("Done with foreground work; awaiting steered child.")
+        assert "focused strictly on auth.py" in json.dumps(messages)
+        return _assistant_text("Combined: PARENT_LOCAL_DONE + auth.py audit!")
+
+    parent = Agent(
+        model=CallbackDrivenModel(parent_logic),
+        tools=[sub_tool, parent_step],
+        callback_handler=None,
+    )
+
+    res = await parent.invoke_async("Run audit.")
+    assert "Combined: PARENT_LOCAL_DONE + auth.py audit!" in str(res)
+    assert "parent:parallel_work" in timeline
+    assert "child:applied_midflight_steering" in timeline
+
+
+@pytest.mark.asyncio
+async def test_vended_subagent_hangup_wakeup_and_history_salvaging_recover() -> None:
+    """When a background native `subagent` stalls on a hung tool after completing Step 1:
+    1. The parent wakes up automatically via `[subagent-hangup]` instead of freezing.
+    2. `action='recover'` cancels the hung child, salvages Step 1 via native `_fork_messages`
+       (dropping the unanswered hung `toolUse`), switches tools/task, and completes without redoing Step 1."""
+    step1_count = 0
+
+    @tool(name="fetch_manifest")
+    async def fetch_manifest() -> str:
+        """Step 1 succeeds."""
+        nonlocal step1_count
+        step1_count += 1
+        return "MANIFEST_DATA(v4.2)"
+
+    @tool(name="hung_service")
+    async def hung_service() -> str:
+        """Hangs indefinitely."""
+        await asyncio.sleep(60.0)
+        return "never"
+
+    @tool(name="backup_service")
+    async def backup_service(manifest: str) -> str:
+        """Fast fallback."""
+        return f"VERIFIED_BY_BACKUP({manifest})"
+
+    def child_logic(messages, _specs, _sys):
+        dump = json.dumps(messages)
+        if "MANIFEST_DATA(v4.2)" not in dump:
+            return _assistant_tool("fetch_manifest", "c-1", {})
+        if "VERIFIED_BY_BACKUP" in dump:
+            return _assistant_text("Recovered report: MANIFEST_DATA(v4.2) + VERIFIED_BY_BACKUP")
+        if "Use backup_service instead of hung_service" in dump:
+            return _assistant_tool("backup_service", "c-3", {"manifest": "MANIFEST_DATA(v4.2)"})
+        return _assistant_tool("hung_service", "c-2", {})
+
+    sub_tool = make_subagent(
+        builder=lambda spec: Agent(
+            model=CallbackDrivenModel(child_logic),
+            system_prompt=spec.instructions or "",
+            tools=[
+                t
+                for t in (fetch_manifest, hung_service, backup_service)
+                if spec.tools is None or t.tool_name in spec.tools
+            ],
+            callback_handler=None,
+        ),
+        presets={
+            "primary": Preset(instructions="Use primary service.", tools=["fetch_manifest", "hung_service"]),
+            "fallback": Preset(instructions="Use backup service.", tools=["fetch_manifest", "backup_service"]),
+        },
+        tools=Choice(["fetch_manifest", "hung_service", "backup_service"], multiple=True),
+        instructions=Fixed(None),
+        background=True,
+        stall_timeout=0.18,
+    )
+
+    first_id: str | None = None
+    turn = 0
+
+    def parent_logic(messages, _specs, _sys):
+        nonlocal turn, first_id
+        turn += 1
+        if turn == 1:
+            return _assistant_tool("subagent", "p-1", {"agent_type": "primary", "task": "Verify manifest"})
+        if turn == 2:
+            first_id = messages[-1]["content"][0]["toolResult"]["content"][0]["json"]["subagent_id"]
+            return _assistant_text("Waiting on background verification.")
+        if turn == 3:
+            # Woken by `[subagent-hangup]`!
+            alert = messages[-1]["content"][0]["text"]
+            assert "[subagent-hangup]" in alert
+            assert "hung_service" in alert
+            assert "MANIFEST_DATA(v4.2)" in alert
+            return _assistant_tool(
+                "subagent",
+                "p-2",
+                {
+                    "action": "recover",
+                    "subagent_id": first_id,
+                    "agent_type": "fallback",
+                    "tools": ["fetch_manifest", "backup_service"],
+                    "task": "Use backup_service instead of hung_service with the salvaged manifest.",
+                },
+            )
+        if turn == 4:
+            rec = messages[-1]["content"][0]["toolResult"]["content"][0]["json"]
+            assert rec["salvaged_message_count"] >= 2
+            return _assistant_text("Recovered subagent running on fallback preset.")
+        assert "VERIFIED_BY_BACKUP(MANIFEST_DATA(v4.2))" in json.dumps(messages)
+        return _assistant_text("Completed after automatic hangup recovery!")
+
+    parent = Agent(model=CallbackDrivenModel(parent_logic), tools=[sub_tool], callback_handler=None)
+
+    t0 = time.monotonic()
+    result = await parent.invoke_async("Verify manifest.")
+    elapsed = time.monotonic() - t0
+
+    assert elapsed < 2.5
+    assert step1_count == 1  # Salvaged! Never re-executed!
+    assert "Completed after automatic hangup recovery!" in str(result)
+
