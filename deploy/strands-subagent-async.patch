+"""Subagent tool for delegating a task to a child agent at runtime.
+
+Provides :func:`make_subagent` (a factory that lets the developer pin safety
+limits, authority modes, and optional async background execution with hangup
+recovery). Each call resolves the model's arguments through the authority-mode
+system (see :mod:`~strands.multiagent.spec`), builds a child agent via an
+:data:`AgentBuilder`, runs it (inline or in the background), and streams or
+delivers the result back.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import copy
+import json
+import logging
+import math
+import re
+import threading
+import time
+import uuid
+import weakref
+from collections import deque
+from collections.abc import AsyncIterator, Callable, Mapping
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any, Literal, cast
+
+from ...agent.conversation_manager.compression.context_compression import find_valid_trim_point
+from ...hooks import AfterInvocationEvent, AfterToolCallEvent, BeforeToolCallEvent
+from ...multiagent._agent_tool_streamer import (
+    _AgentToolStreamer,
+    _ChildAgentAdapter,
+)
+from ...multiagent.spec import (
+    AgentBuilder,
+    AgentSpec,
+    Choice,
+    Fixed,
+    Inherit,
+    Open,
+    Preset,
+    _build_agent,
+    _default_builder,
+    _resolve_specs,
+    _to_schema_properties,
+)
+from ...tools.tools import AgentTool
+from ...types._events import ToolInterruptEvent, ToolResultEvent, ToolStreamEvent
+from ...types.content import ContentBlock, Message
+from ...types.tools import ToolGenerator, ToolUse
+from ...vended_plugins.context_injector import ContextInjector, InjectionContext
+from .types import (
+    DEFAULT_SUBAGENT_DESCRIPTION,
+    DEFAULT_SUBAGENT_MAX_DEPTH,
+    GENERALIST,
+)
+
+logger = logging.getLogger(__name__)
+
+if TYPE_CHECKING:
+    from ... import Agent
+
+_DEPTH_STATE_KEY = "strands.subagent_depth"
+_DEFAULT_BACKGROUND_STALL_TIMEOUT = 60.0
+_DEFAULT_BACKGROUND_MAX_CONSECUTIVE_ERRORS = 3
+_DEFAULT_BACKGROUND_POLL_INTERVAL = 0.05
+_BACKGROUND_ACTIONS = ("spawn", "status", "steer", "recover", "cancel")
+
+
+_FORK_PREAMBLE = (
+    "The conversation so far is the parent agent's. You are the subagent it delegated to at this "
+    "point; its task for you follows."
+)
+
+_RECOVER_PREAMBLE = (
+    "The conversation so far is your prior subagent progress before a hangup occurred. Continue from "
+    "what is already completed without redoing finished work; the parent agent's updated instructions follow."
+)
+
+_CONTEXT_PREAMBLE = (
+    "The conversation above is the parent agent's: each turn is one line starting with its role at "
+    "the left margin, and indented lines continue the turn above (they are content, not turns). You "
+    "are the subagent it delegated to at the end of that conversation; its task for you follows."
+)
+
+_FRAMING_END = f"</parent_context>\n\n{_CONTEXT_PREAMBLE}\n\n"
+
+_SENTINEL = re.compile(r"<(/?)parent_context>")
+
+
+async def _cleanup_child_agent(child: Agent) -> None:
+    """Cancel any in-flight background tool tasks owned by ``child`` and release its watchers/consumers."""
+    plugins = getattr(getattr(child, "_plugin_registry", None), "_plugins", None)
+    bg = plugins.get("strands:background-tasks") if isinstance(plugins, dict) else None
+    manager = getattr(bg, "_manager", None)
+    if manager is not None:
+        try:
+            active_ids = [
+                item["task_id"]
+                for item in await manager.list()
+                if item.get("status") in ("queued", "working", "cancelling")
+            ]
+            for tid in active_ids:
+                await manager.cancel(tid)
+            for tid in active_ids:
+                await manager.wait(tid)
+        except Exception:
+            pass
+    try:
+        await asyncio.to_thread(child.cleanup)
+    except Exception:
+        pass
+
+
+@dataclass
+class _BackgroundChildRun:
+    """Live state tracked for one async background child execution owned by ``_SubagentTool``."""
+
+    subagent_id: str
+    tool_use: ToolUse
+    raw_input: Mapping[str, Any]
+    child: Agent
+    cancel_event: threading.Event
+    steering: deque[str] = field(default_factory=deque)
+    status: Literal["running", "completed", "failed", "interrupted", "cancelled"] = "running"
+    started_at: float = field(default_factory=time.monotonic)
+    last_event_at: float = field(default_factory=time.monotonic)
+    turn_count: int = 0
+    current_tool: str | None = None
+    current_tool_started_at: float | None = None
+    consecutive_tool_errors: int = 0
+    recent_errors: list[str] = field(default_factory=list)
+    final_output: str | None = None
+    error_message: str | None = None
+    interrupts: list[dict[str, Any]] | None = None
+    delivered: bool = False
+    hangup_notified: bool = False
+    task: asyncio.Task[None] | None = None
+
+    def salvaged_findings(self, limit: int = 6) -> list[str]:
+        """Extract compact text summaries of completed tool results and assistant messages."""
+        items: list[str] = []
+        for msg in self.child.messages:
+            role = msg.get("role")
+            for block in msg.get("content", []):
+                if "toolResult" in block and block["toolResult"].get("status") == "success":
+                    for inner in block["toolResult"].get("content", []):
+                        if "text" in inner and inner["text"].strip():
+                            items.append(inner["text"].strip()[:300])
+                elif role == "assistant" and "text" in block and block["text"].strip():
+                    items.append(block["text"].strip()[:300])
+        return items[-limit:]
+
+    def snapshot(self) -> dict[str, Any]:
+        """Serializable live status and progress view for the parent agent."""
+        now = time.monotonic()
+        snap: dict[str, Any] = {
+            "subagent_id": self.subagent_id,
+            "status": self.status,
+            "elapsed_s": round(now - self.started_at, 2),
+            "idle_s": round(now - self.last_event_at, 2),
+            "turn_count": self.turn_count,
+            "current_tool": self.current_tool,
+            "current_tool_elapsed_s": (
+                round(now - self.current_tool_started_at, 2) if self.current_tool_started_at is not None else None
+            ),
+            "consecutive_tool_errors": self.consecutive_tool_errors,
+            "recent_errors": self.recent_errors[-3:],
+            "salvaged_progress": self.salvaged_findings(),
+        }
+        todos = self.child.state.get("todos")
+        if todos:
+            snap["todos"] = todos
+        if self.final_output is not None:
+            snap["result"] = self.final_output
+        if self.error_message is not None:
+            snap["error"] = self.error_message
+        if self.interrupts is not None:
+            snap["interrupts"] = self.interrupts
+        return snap
+
+
+def _build_schema(
+    *,
+    presets: Mapping[str, Preset],
+    default_preset: str | None,
+    instructions: Open | Choice | Fixed,
+    tools: Choice | Fixed | Inherit | None,
+    model: Inherit | Choice | Fixed,
+    context: Fixed | Choice,
+    background: bool = False,
+) -> dict[str, Any]:
+    """Derive the tool's input schema from the axis modes and background setting."""
+    properties: dict[str, Any] = {}
+    if background:
+        properties["action"] = {
+            "type": "string",
+            "enum": list(_BACKGROUND_ACTIONS),
+            "description": (
+                "Background subagent operation. Omit or use 'spawn' to start a background subagent and continue "
+                "working immediately; 'status' to inspect live progress; 'steer' to send mid-flight guidance (`task`) "
+                "to a running subagent without restarting it; 'recover' to cancel a hung/stalled subagent, salvage "
+                "its completed history, and continue with adjusted `task`/axis settings; 'cancel' to stop and return "
+                "salvaged progress."
+            ),
+        }
+        properties["subagent_id"] = {
+            "type": "string",
+            "description": "Target background subagent ID (required for 'status', 'steer', 'recover', and 'cancel').",
+        }
+    properties["task"] = {
+        "type": "string",
+        "description": (
+            "The self-contained task (for 'spawn'), mid-flight guidance (for 'steer'), or adjusted instructions "
+            "(for 'recover')."
+            if background
+            else "The self-contained task, including all context the subagent needs. It cannot ask follow-up questions."
+        ),
+    }
+    properties.update(
+        _to_schema_properties(
+            presets=presets,
+            default_preset=default_preset,
+            instructions=instructions,
+            tools=tools,
+            model=model,
+        )
+    )
+    if isinstance(context, Choice):
+        options = context.normalized()
+        lines = [f"- {option.name}: {option.description}" for option in options if option.description]
+        options_text = "\nOptions:\n" + "\n".join(lines) if lines else ""
+        properties["context"] = {
+            "type": "string",
+            "enum": [option.name for option in options],
+            "description": "How much of this conversation the subagent sees: 'none' (fresh start), 'all' (full "
+            "history including tool calls and their results — can be large), 'no_tools' (text turns "
+            "only — tool calls and their results removed). More context costs more tokens." + options_text,
+        }
+    if isinstance(context, Choice) and any(str(o.value) != "none" for o in context.normalized()):
+        properties["last_messages"] = {
+            "type": "integer",
+            "description": "Optional: limit the shared context to the last N messages. Omit to "
+            "share all of the selected context.",
+        }
+    required = [] if background else ["task"]
+    return {"type": "object", "properties": properties, "required": required}
+
+
+async def _iter_with_stall_timeout(
+    events: AsyncIterator[dict[str, Any]],
+    *,
+    stall_timeout: float | None,
+    on_stall: Callable[[], None],
+) -> AsyncIterator[dict[str, Any]]:
+    """Consume an async event iterator with an optional per-event stall timeout."""
+    if stall_timeout is None:
+        async for event in events:
+            yield event
+        return
+    iterator = events.__aiter__()
+    while True:
+        try:
+            event = await asyncio.wait_for(iterator.__anext__(), timeout=stall_timeout)
+        except StopAsyncIteration:
+            return
+        except asyncio.TimeoutError:
+            on_stall()
+            return
+        yield event
+
+
+class _SubagentTool(AgentTool):
+    """Streams a fresh per-call child (foreground) or supervises non-blocking async children (background)."""
+
+    def __init__(
+        self,
+        name: str,
+        tool_spec: dict[str, Any],
+        resolve: Callable[[Mapping[str, Any]], AgentSpec],
+        context: Fixed | Choice,
+        builder: AgentBuilder | None,
+        max_depth: int,
+        *,
+        background: bool = False,
+        stall_timeout: float | None = None,
+        max_consecutive_errors: int | None = None,
+        poll_interval: float = _DEFAULT_BACKGROUND_POLL_INTERVAL,
+    ) -> None:
+        super().__init__()
+        self._name = name
+        self._adapter = _ChildAgentAdapter(label="Subagent", agent_name=name)
+        self._spec = tool_spec
+        self._resolve = resolve
+        self._context = context
+        self._builder = builder
+        self._max_depth = max_depth
+        self._background = background
+        self._stall_timeout = (
+            _DEFAULT_BACKGROUND_STALL_TIMEOUT if (background and stall_timeout is None) else stall_timeout
+        )
+        self._max_consecutive_errors = (
+            _DEFAULT_BACKGROUND_MAX_CONSECUTIVE_ERRORS
+            if (background and max_consecutive_errors is None)
+            else max_consecutive_errors
+        )
+        self._poll_interval = poll_interval
+        # Per-parent background run registry & one-time hook attachment tracking.
+        self._runs_by_parent: weakref.WeakKeyDictionary[Any, dict[str, _BackgroundChildRun]] = (
+            weakref.WeakKeyDictionary()
+        )
+        self._attached_parents: weakref.WeakSet[Any] = weakref.WeakSet()
+
+    @property
+    def background(self) -> bool:
+        """Whether this subagent tool dispatches and supervises children asynchronously in the background."""
+        return self._background
+
+    @property
+    def tool_name(self) -> str:
+        return self._name
+
+    @property
+    def tool_spec(self) -> Any:
+        return self._spec
+
+    @property
+    def tool_type(self) -> str:
+        return "agent"
+
+    def _fork_messages(self, source_agent: Agent | None, last_n: int | None) -> list[Message]:
+        """Deep-copy an agent's messages, dropping in-flight tool calls, reasoning, and injected blocks.
+
+        After filtering, consecutive messages of the same role are merged so the
+        result always alternates user/assistant.
+        """
+        if source_agent is None:
+            return []
+        answered = {b["toolResult"]["toolUseId"] for m in source_agent.messages for b in m["content"] if "toolResult" in b}
+        filtered: list[Message] = []
+        for message in source_agent.messages:
+            content = [
+                b
+                for b in message["content"]
+                if "reasoningContent" not in b
+                # Context for the parent's own turn.
+                and "injected" not in b
+                and ("toolUse" not in b or b["toolUse"]["toolUseId"] in answered)
+            ]
+            if content:
+                filtered.append({"role": message["role"], "content": copy.deepcopy(content)})
+
+        # Merge consecutive messages of the same role.
+        forked: list[Message] = []
+        for msg in filtered:
+            if forked and forked[-1]["role"] == msg["role"]:
+                forked[-1]["content"].extend(msg["content"])
+            else:
+                forked.append(msg)
+
+        if last_n is not None and last_n > 0:
+            # Search backwards for a valid trim point using a 2-element window.
+            start = max(len(forked) - last_n, 0)
+            while start > 0 and find_valid_trim_point(forked[start : start + 2], 0) != 0:
+                start -= 1
+            forked = forked[start:]
+        return forked
+
+    def _render_context(self, parent: Agent | None, last_n: int | None) -> str:
+        """Render the parent's text turns as a plain-text block for ``"no_tools"`` context mode."""
+        if parent is None:
+            return ""
+        messages = parent.messages
+        if last_n is not None and last_n > 0:
+            messages = messages[-last_n:]
+        lines = []
+        for message in messages:
+            text = " ".join(b["text"] for b in message["content"] if "text" in b).strip()
+            if text.startswith("<parent_context>\n"):
+                _, found, stripped = text.partition(_FRAMING_END)
+                if found:
+                    text = stripped
+            if text:
+                lines.append(f"{message['role']}: {text}".replace("\n", "\n  "))
+        return _SENTINEL.sub(r"<\\\1parent_context>", "\n".join(lines))
+
+    def _resolve_context(self, raw: Mapping[str, Any]) -> tuple[str, int | None]:
+        """Resolve context mode and last_messages from the model's raw input and the context axis."""
+        ctx_mode = "none"
+        if isinstance(self._context, Choice):
+            raw_ctx = raw.get("context")
+            if raw_ctx is not None and any(o.name == str(raw_ctx) for o in self._context.normalized()):
+                ctx_mode = str(self._context.value_for(str(raw_ctx)))
+        elif isinstance(self._context, Fixed) and self._context.value is not None:
+            ctx_mode = str(self._context.value)
+
+        last_n = None
+        raw_last = raw.get("last_messages")
+        if raw_last is not None:
+            try:
+                last_n = int(raw_last)
+                if last_n < 1:
+                    last_n = None
+            except (TypeError, ValueError):
+                pass
+
+        return ctx_mode, last_n
+
+    def _error_result(self, tool_use_id: str, text: str) -> ToolResultEvent:
+        return ToolResultEvent({"toolUseId": tool_use_id, "status": "error", "content": [{"text": text}]})
+
+    async def _prepare_child(
+        self,
+        tool_use: ToolUse,
+        raw: Mapping[str, Any],
+        parent: Agent | None,
+        tool_streamer: _AgentToolStreamer | None = None,
+        *,
+        salvaged_messages: list[Message] | None = None,
+    ) -> tuple[Agent, Any] | str | ToolInterruptEvent | ToolResultEvent:
+        """Resolve or resume the child agent and its prompt.
+
+        Returns ``(child, prompt)`` on success, a ``str`` error message on validation failure, or the
+        event to yield if the child's stored turn could not be resumed.
+        """
+        if tool_streamer is not None and tool_streamer.is_resuming():
+            return await self._prepare_resume(tool_use, raw, parent, tool_streamer)
+
+        stored_depth = None if parent is None else parent.state.get(_DEPTH_STATE_KEY)
+        depth = self._max_depth if stored_depth is None else stored_depth
+        if depth <= 0:
+            return (
+                f"Delegation depth limit reached ({self._max_depth} levels); you cannot delegate "
+                "further. Complete this task yourself instead of calling subagent again."
+            )
+        task = raw.get("task")
+        if not isinstance(task, str) or not task.strip():
+            return "Missing required parameter 'task': describe the task to delegate."
+
+        spec = self._resolve(raw)
+        build = self._builder or _default_builder(parent)  # type: ignore[arg-type]
+        child = await _build_agent(build, spec)
+        child.state.set(_DEPTH_STATE_KEY, depth - 1)
+
+        if salvaged_messages:
+            framed_recover: ContentBlock = {"text": f"{_RECOVER_PREAMBLE}\n\n{task}"}
+            if salvaged_messages[-1]["role"] == "user":
+                prompt: Any = [
+                    *salvaged_messages[:-1],
+                    {"role": "user", "content": [*salvaged_messages[-1]["content"], framed_recover]},
+                ]
+            else:
+                prompt = [*salvaged_messages, {"role": "user", "content": [framed_recover]}]
+            return child, prompt
+
+        ctx_mode, last_messages = self._resolve_context(raw)
+
+        prompt = task
+        if ctx_mode == "all":
+            messages = self._fork_messages(parent, last_messages)
+            if messages:
+                framed: ContentBlock = {"text": f"{_FORK_PREAMBLE}\n\n{task}"}
+                if messages[-1]["role"] == "user":
+                    prompt = [
+                        *messages[:-1],
+                        {"role": "user", "content": [*messages[-1]["content"], framed]},
+                    ]
+                else:
+                    prompt = [*messages, {"role": "user", "content": [framed]}]
+        elif ctx_mode == "no_tools":
+            block = self._render_context(parent, last_messages)
+            if block:
+                prompt = f"<parent_context>\n{block}\n</parent_context>\n\n{_CONTEXT_PREAMBLE}\n\n{task}"
+
+        return child, prompt
+
+    async def _prepare_resume(
+        self, tool_use: ToolUse, raw: Mapping[str, Any], parent: Agent | None, tool_streamer: _AgentToolStreamer
+    ) -> tuple[Agent, Any] | ToolInterruptEvent | ToolResultEvent:
+        """Rebuild the interrupted child from the same tool input and restore its stored turn."""
+        spec = self._resolve(raw)
+        build = self._builder or _default_builder(parent)  # type: ignore[arg-type]
+        child: Agent | None = None
+        try:
+            child = await _build_agent(build, spec)
+        except Exception as error:
+            logger.warning(
+                "tool_name=<%s>, tool_use_id=<%s> | failed to rebuild interrupted subagent: %s",
+                self._name,
+                tool_use["toolUseId"],
+                error,
+            )
+        resumed = tool_streamer.resume(
+            self._adapter,
+            child,
+            "Subagent did NOT run and the response was NOT applied: its interrupted turn is not available. "
+            "Do not report the delegated task as completed; if it is still needed, delegate it again.",
+        )
+        if resumed is None:
+            return tool_streamer.terminal_event(tool_use)
+        # resume() returns an event when there is no child to resume.
+        return cast("Agent", child), resumed
+
+    # ------------------------------------------------------------------
+    # Native Async Background Supervision (when `background=True`)
+    # ------------------------------------------------------------------
+    def _runs_for(self, parent: Agent) -> dict[str, _BackgroundChildRun]:
+        runs = self._runs_by_parent.get(parent)
+        if runs is None:
+            runs = {}
+            self._runs_by_parent[parent] = runs
+        return runs
+
+    def _detect_hangup(self, run: _BackgroundChildRun) -> str | None:
+        if run.status != "running":
+            return None
+        now = time.monotonic()
+        if (
+            self._stall_timeout is not None
+            and run.current_tool_started_at is not None
+            and (now - run.current_tool_started_at) >= self._stall_timeout
+        ):
+            return f"Tool {run.current_tool!r} hung for {now - run.current_tool_started_at:.2f}s"
+        if self._stall_timeout is not None and (now - run.last_event_at) >= self._stall_timeout:
+            return f"Subagent stream stalled with no progress for {now - run.last_event_at:.2f}s"
+        if (
+            self._max_consecutive_errors is not None
+            and run.consecutive_tool_errors >= self._max_consecutive_errors
+        ):
+            last_err = run.recent_errors[-1] if run.recent_errors else "unknown error"
+            return f"Subagent hit {run.consecutive_tool_errors} consecutive tool errors ({last_err})"
+        return None
+
+    def _ensure_parent_hooks(self, parent: Agent) -> None:
+        """Lazily attach ephemeral telemetry injection and end-of-turn hangup/settlement wakeup to ``parent``."""
+        if parent in self._attached_parents:
+            return
+        self._attached_parents.add(parent)
+
+        def render_telemetry(_ctx: InjectionContext) -> str | None:
+            runs = self._runs_by_parent.get(parent)
+            if not runs:
+                return None
+            undelivered = [r for r in runs.values() if not r.delivered]
+            if not undelivered:
+                return None
+            lines = [f"<system-reminder>\nBackground {self._name} runs:"]
+            for r in undelivered:
+                snap = r.snapshot()
+                hangup = self._detect_hangup(r)
+                flag = f" [HANGUP: {hangup}]" if hangup else ""
+                lines.append(
+                    f"- {r.subagent_id}: status={snap['status']}{flag}, turns={snap['turn_count']}, "
+                    f"tool={snap['current_tool']} ({snap['current_tool_elapsed_s']}s), "
+                    f"errors={snap['consecutive_tool_errors']}"
+                )
+            lines.append("</system-reminder>")
+            return "\n".join(lines)
+
+        ContextInjector(
+            render_telemetry,
+            name=f"strands:subagent-telemetry:{self._name}:{id(self)}",
+            trigger="everyTurn",
+        ).init_agent(parent)
+
+        async def on_after_invocation(event: AfterInvocationEvent) -> None:
+            runs = self._runs_by_parent.get(parent)
+            if not runs:
+                return
+            if event.result is not None and event.result.stop_reason not in ("end_turn", "stop_sequence"):
+                return
+
+            while True:
+                if parent.cancel_signal.is_set():
+                    for r in runs.values():
+                        if r.status == "running":
+                            r.cancel_event.set()
+                            if r.task is not None and not r.task.done():
+                                r.task.cancel()
+                    return
+
+                settled = [r for r in runs.values() if r.status != "running" and not r.delivered]
+                if settled:
+                    for r in settled:
+                        r.delivered = True
+                    payload = json.dumps([r.snapshot() for r in settled], indent=2)
+                    event.resume = f"[{self._name}-completed] Background subagent(s) finished:\n{payload}"
+                    return
+
+                running = [r for r in runs.values() if r.status == "running"]
+                if not running:
+                    return
+
+                hung: list[tuple[_BackgroundChildRun, str]] = []
+                for r in running:
+                    reason = self._detect_hangup(r)
+                    if reason and not r.hangup_notified:
+                        hung.append((r, reason))
+
+                if hung:
+                    alerts = []
+                    for r, reason in hung:
+                        r.hangup_notified = True
+                        alerts.append({"hangup_reason": reason, **r.snapshot()})
+                    event.resume = (
+                        f"[{self._name}-hangup] Background subagent hangup detected. Call `{self._name}` with "
+                        f"action='steer' (send mid-flight guidance), action='recover' (cancel hung step, salvage "
+                        f"completed history, and continue with adjusted `task`/tools/model), or action='cancel':\n"
+                        + json.dumps(alerts, indent=2)
+                    )
+                    return
+
+                tasks = [r.task for r in running if r.task is not None]
+                if not tasks:
+                    return
+                await asyncio.wait(tasks, timeout=self._poll_interval, return_when=asyncio.FIRST_COMPLETED)
+
+        parent.add_hook(on_after_invocation, AfterInvocationEvent)
+
+    async def _spawn_background_run(
+        self,
+        tool_use: ToolUse,
+        raw: Mapping[str, Any],
+        parent: Agent,
+        invocation_state: dict[str, Any],
+        *,
+        salvaged_messages: list[Message] | None = None,
+    ) -> _BackgroundChildRun | ToolResultEvent | ToolInterruptEvent:
+        prepared = await self._prepare_child(
+            tool_use, raw, parent, tool_streamer=None, salvaged_messages=salvaged_messages
+        )
+        if not isinstance(prepared, tuple):
+            return self._error_result(tool_use["toolUseId"], prepared) if isinstance(prepared, str) else prepared
+        child, prompt = prepared
+
+        sub_id = f"{self._name}-{uuid.uuid4().hex[:8]}"
+        cancel_ev = threading.Event()
+        steering_q: deque[str] = deque()
+
+        def render_child_steering(_ctx: InjectionContext) -> str | None:
+            if not steering_q:
+                return None
+            items: list[str] = []
+            while steering_q:
+                items.append(steering_q.popleft())
+            return "<parent-steering>\n" + "\n".join(items) + "\n</parent-steering>"
+
+        ContextInjector(
+            render_child_steering,
+            name=f"strands:subagent-steering:{sub_id}",
+            trigger="everyTurn",
+        ).init_agent(child)
+
+        synthetic_tool_use: ToolUse = {
+            "toolUseId": sub_id,
+            "name": self._name,
+            "input": {"task": raw.get("task", ""), "subagent_id": sub_id},
+        }
+        run = _BackgroundChildRun(
+            subagent_id=sub_id,
+            tool_use=synthetic_tool_use,
+            raw_input=dict(raw),
+            child=child,
+            cancel_event=cancel_ev,
+            steering=steering_q,
+        )
+
+        def on_before_tool(ev: BeforeToolCallEvent) -> None:
+            run.current_tool = ev.tool_use["name"]
+            run.current_tool_started_at = time.monotonic()
+            run.last_event_at = time.monotonic()
+
+        def on_after_tool(ev: AfterToolCallEvent) -> None:
+            run.current_tool = None
+            run.current_tool_started_at = None
+            run.last_event_at = time.monotonic()
+            if ev.result.get("status") == "error":
+                run.consecutive_tool_errors += 1
+                err_txt = next((b["text"] for b in ev.result.get("content", []) if "text" in b), "tool error")
+                run.recent_errors.append(f"{ev.tool_use['name']}: {err_txt[:200]}")
+            else:
+                run.consecutive_tool_errors = 0
+
+        child.add_hook(on_before_tool, BeforeToolCallEvent)
+        child.add_hook(on_after_tool, AfterToolCallEvent)
+
+        child_state = {**invocation_state} if isinstance(invocation_state, dict) else invocation_state
+        streamer = _AgentToolStreamer(
+            interrupt_state=None,
+            tool_use_id=sub_id,
+            namespace="v1:subagent",
+            persist_interrupted_turn=False,
+        )
+
+        async def drive() -> None:
+            try:
+                source = child.stream_async(prompt, invocation_state=child_state, cancel_signal=cancel_ev)
+                async for ev in streamer.stream(self._adapter, child, source):
+                    run.last_event_at = time.monotonic()
+                    if ev.get("start_event_loop"):
+                        run.turn_count += 1
+                    stream_ev = ToolStreamEvent(synthetic_tool_use, ev)
+                    stream_ev.prepare(invocation_state=child_state)
+                    parent.callback_handler(**stream_ev.as_dict())
+
+                if cancel_ev.is_set():
+                    run.status = "cancelled"
+                elif streamer.interrupts is not None:
+                    run.status = "interrupted"
+                    run.interrupts = [i.to_dict() for i in streamer.interrupts]
+                elif streamer.error is not None:
+                    run.status = "failed"
+                    run.error_message = streamer.error
+                else:
+                    run.status = "completed"
+                    run.final_output = str(streamer.result)
+            except asyncio.CancelledError:
+                run.status = "cancelled"
+            except Exception as exc:
+                run.status = "failed"
+                run.error_message = str(exc)
+                run.recent_errors.append(str(exc))
+            finally:
+                run.current_tool = None
+                run.current_tool_started_at = None
+                run.last_event_at = time.monotonic()
+                if run.status != "interrupted":
+                    await _cleanup_child_agent(child)
+
+        self._ensure_parent_hooks(parent)
+        runs = self._runs_for(parent)
+        run.task = asyncio.create_task(drive())
+        runs[sub_id] = run
+        return run
+
+    async def _handle_background_call(
+        self, tool_use: ToolUse, raw: Mapping[str, Any], parent: Agent | None, invocation_state: dict[str, Any]
+    ) -> ToolResultEvent | ToolInterruptEvent:
+        tool_use_id = tool_use["toolUseId"]
+        if parent is None:
+            return self._error_result(tool_use_id, "Background subagent requires a parent Agent in invocation_state.")
+
+        action = str(raw.get("action") or "spawn")
+        if action not in _BACKGROUND_ACTIONS:
+            return self._error_result(
+                tool_use_id, f"Unknown action {action!r}; valid values: {list(_BACKGROUND_ACTIONS)}."
+            )
+
+        if action == "spawn":
+            spawned = await self._spawn_background_run(tool_use, raw, parent, invocation_state)
+            if not isinstance(spawned, _BackgroundChildRun):
+                return spawned
+            return ToolResultEvent(
+                {
+                    "toolUseId": tool_use_id,
+                    "status": "success",
+                    "content": [
+                        {
+                            "json": {
+                                "subagent_id": spawned.subagent_id,
+                                "status": "running",
+                                "message": (
+                                    "Subagent dispatched asynchronously in the background. Continue your own work; "
+                                    "results (or hangup alerts) will be delivered automatically, or inspect/adjust "
+                                    f"anytime with `{self._name}` action='status'|'steer'|'recover'|'cancel'."
+                                ),
+                            }
+                        }
+                    ],
+                }
+            )
+
+        subagent_id = raw.get("subagent_id")
+        runs = self._runs_for(parent)
+        if not isinstance(subagent_id, str) or subagent_id not in runs:
+            return self._error_result(
+                tool_use_id,
+                f"Unknown or missing subagent_id {subagent_id!r}. Active IDs: {sorted(runs)}.",
+            )
+        target = runs[subagent_id]
+
+        if action == "status":
+            return ToolResultEvent(
+                {"toolUseId": tool_use_id, "status": "success", "content": [{"json": target.snapshot()}]}
+            )
+
+        if action == "steer":
+            guidance = raw.get("task")
+            if not isinstance(guidance, str) or not guidance.strip():
+                return self._error_result(tool_use_id, "Parameter 'task' is required for action='steer'.")
+            if target.status != "running":
+                return self._error_result(
+                    tool_use_id,
+                    f"Cannot steer subagent {subagent_id!r} with status={target.status!r}; use action='recover' instead.",
+                )
+            target.steering.append(guidance)
+            target.hangup_notified = False
+            return ToolResultEvent(
+                {
+                    "toolUseId": tool_use_id,
+                    "status": "success",
+                    "content": [{"json": {"steered": subagent_id, "queued_guidance": guidance, **target.snapshot()}}],
+                }
+            )
+
+        # `cancel` or `recover`: stop the target run cleanly and salvage completed turns.
+        target.cancel_event.set()
+        if target.task is not None and not target.task.done():
+            target.task.cancel()
+            await asyncio.gather(target.task, return_exceptions=True)
+        await _cleanup_child_agent(target.child)
+        target.status = "cancelled"
+        target.delivered = True
+        salvaged_snap = target.snapshot()
+
+        if action == "cancel":
+            return ToolResultEvent(
+                {"toolUseId": tool_use_id, "status": "success", "content": [{"json": {"cancelled": salvaged_snap}}]}
+            )
+
+        # `recover`: fork valid completed messages from `target.child` (automatically dropping the unanswered
+        # hung `toolUse`!) and spawn a continuation child with the adjusted `raw` parameters.
+        salvaged_messages = self._fork_messages(target.child, last_n=None)
+        merged_raw: dict[str, Any] = {**target.raw_input, **raw, "action": "spawn"}
+        replacement = await self._spawn_background_run(
+            tool_use, merged_raw, parent, invocation_state, salvaged_messages=salvaged_messages
+        )
+        if not isinstance(replacement, _BackgroundChildRun):
+            return replacement
+        return ToolResultEvent(
+            {
+                "toolUseId": tool_use_id,
+                "status": "success",
+                "content": [
+                    {
+                        "json": {
+                            "recovered_from": subagent_id,
+                            "salvaged_message_count": len(salvaged_messages),
+                            "salvaged_progress": salvaged_snap["salvaged_progress"],
+                            "subagent_id": replacement.subagent_id,
+                            "status": "running",
+                        }
+                    }
+                ],
+            }
+        )
+
+    # ------------------------------------------------------------------
+    # Standard AgentTool Streaming Entry Point
+    # ------------------------------------------------------------------
+    async def stream(self, tool_use: ToolUse, invocation_state: dict[str, Any], **kwargs: Any) -> ToolGenerator:
+        tool_use_id = tool_use["toolUseId"]
+        raw = tool_use.get("input", {}) or {}
+        parent = invocation_state.get("agent")
+
+        if self._background:
+            yield await self._handle_background_call(tool_use, raw, parent, invocation_state)
+            return
+
+        tool_context = kwargs.get("_tool_context")
+        # When running inside `_BackgroundTasks`, `_BackgroundToolContext` owns its own `_task_interrupt_state`;
+        # yielding a `v1:subagent:` interrupt unregistered in `_task_interrupt_state` raises `RuntimeError` in
+        # `InProcessTaskManager._execute_tool_task`.
+        in_sdk_background_task = hasattr(tool_context, "_task_interrupt_state")
+        tool_streamer = _AgentToolStreamer(
+            interrupt_state=None if in_sdk_background_task else getattr(parent, "_interrupt_state", None),
+            tool_use_id=tool_use_id,
+            namespace="v1:subagent",
+            persist_interrupted_turn=not in_sdk_background_task,
+        )
+
+        try:
+            prepared = await self._prepare_child(tool_use, raw, parent, tool_streamer)
+            if not isinstance(prepared, tuple):
+                yield self._error_result(tool_use_id, prepared) if isinstance(prepared, str) else prepared
+                return
+            child, prompt = prepared
+
+            external_cancel = (
+                tool_context.cancel_signal if tool_context is not None else getattr(parent, "cancel_signal", None)
+            )
+            local_cancel = threading.Event()
+            stalled = False
+
+            def trigger_stall() -> None:
+                nonlocal stalled
+                stalled = True
+                local_cancel.set()
+
+            cancel_signal: threading.Event | None
+            watcher: asyncio.Task[None] | None = None
+            if self._stall_timeout is not None:
+                cancel_signal = local_cancel
+                if external_cancel is not None:
+                    if external_cancel.is_set():
+                        local_cancel.set()
+                    else:
+
+                        async def _mirror_cancel() -> None:
+                            while not external_cancel.is_set() and not local_cancel.is_set():
+                                await asyncio.sleep(0.02)
+                            if external_cancel.is_set():
+                                local_cancel.set()
+
+                        watcher = asyncio.create_task(_mirror_cancel())
+            else:
+                cancel_signal = external_cancel
+
+            child_state = {**invocation_state} if isinstance(invocation_state, dict) else invocation_state
+            stream_kwargs: dict[str, Any] = {
+                "invocation_state": child_state,
+                "cancel_signal": cancel_signal,
+            }
+            invocation_context = getattr(tool_context, "invocation_context", None) if tool_context is not None else None
+            if invocation_context is not None:
+                stream_kwargs["invocation_context"] = invocation_context
+            source = child.stream_async(prompt, **stream_kwargs)
+            try:
+                guarded = _iter_with_stall_timeout(
+                    tool_streamer.stream(self._adapter, child, source),
+                    stall_timeout=self._stall_timeout,
+                    on_stall=trigger_stall,
+                )
+                async for event in guarded:
+                    yield ToolStreamEvent(tool_use, event)
+            finally:
+                local_cancel.set()
+                if watcher is not None:
+                    watcher.cancel()
+
+            if stalled:
+                partial = "\n".join(
+                    b["text"]
+                    for m in self._fork_messages(child, last_n=None)
+                    if m["role"] == "assistant"
+                    for b in m["content"]
+                    if "text" in b and b["text"].strip()
+                )
+                msg = f"Subagent stalled after {self._stall_timeout}s."
+                if partial:
+                    msg += f"\n\nSalvaged partial output:\n{partial}"
+                yield self._error_result(tool_use_id, msg)
+                return
+
+            if in_sdk_background_task and tool_streamer.interrupts is not None and tool_context is not None:
+                first = tool_streamer.interrupts[0]
+                tool_context.interrupt(first.name, reason=first.reason)
+                return
+
+            yield tool_streamer.terminal_event(tool_use)
+        except Exception as exc:
+            # Let task-scoped `InterruptException` from `tool_context.interrupt(...)` unwind to `_execute_background`.
+            from ...interrupt import InterruptException
+
+            if isinstance(exc, InterruptException):
+                raise
+            logger.warning(
+                "tool_name=<%s>, tool_use_id=<%s> | subagent failed: %s",
+                self._name,
+                tool_use_id,
+                exc,
+            )
+            yield self._error_result(tool_use_id, f"Subagent error: {exc}")
+
+
+def make_subagent(
+    *,
+    builder: AgentBuilder | None = None,
+    presets: Mapping[str, Preset] | None = None,
+    default_preset: str | None = None,
+    instructions: Open | Choice | Fixed | None = None,
+    tools: Choice | Fixed | Inherit | None = None,
+    model: Inherit | Choice | Fixed | None = None,
+    context: Fixed | Choice | None = None,
+    max_depth: int = DEFAULT_SUBAGENT_MAX_DEPTH,
+    name: str = "subagent",
+    description: str = DEFAULT_SUBAGENT_DESCRIPTION,
+    background: bool = False,
+    stall_timeout: float | None = None,
+    max_consecutive_errors: int | None = None,
+) -> AgentTool:
+    """Build a ``subagent`` tool whose schema is derived from the axis modes, presets, and ``background`` mode.
+
+    Each axis accepts a policy from :mod:`~strands.multiagent.spec` that controls what
+    the model sees and can supply. Set ``background=True`` to run children non-blockingly
+    in the background with live telemetry, mid-flight ``steer``, hangup alerts, and
+    history-salvaging ``recover``/``cancel`` actions.
+
+    Raises:
+        ValueError: If *max_depth* < 1, *name* or *description* is empty, *stall_timeout* /
+            *max_consecutive_errors* are non-positive, or a ``Choice`` axis violates its constraints.
+    """
+    if not name:
+        raise ValueError("name must be a non-empty string.")
+    if not description:
+        raise ValueError("description must be a non-empty string.")
+    if not isinstance(max_depth, int) or isinstance(max_depth, bool) or max_depth < 1:
+        raise ValueError("max_depth must be a positive integer (>= 1).")
+    if stall_timeout is not None and (
+        isinstance(stall_timeout, bool)
+        or not isinstance(stall_timeout, (int, float))
+        or not math.isfinite(stall_timeout)
+        or stall_timeout <= 0
+    ):
+        raise ValueError("stall_timeout must be a positive finite number.")
+    if max_consecutive_errors is not None and (
+        isinstance(max_consecutive_errors, bool)
+        or not isinstance(max_consecutive_errors, int)
+        or max_consecutive_errors < 1
+    ):
+        raise ValueError("max_consecutive_errors must be a positive integer (>= 1).")
+
+    presets = dict(presets) if presets is not None else {"generalist": GENERALIST}
+    instructions = instructions if instructions is not None else Open()
+    model = model if model is not None else Inherit()
+    context = context if context is not None else Fixed("none")
+    if default_preset is None and presets:
+        default_preset = next(iter(presets))
+
+    schema = _build_schema(
+        presets=presets,
+        default_preset=default_preset,
+        instructions=instructions,
+        tools=tools,
+        model=model,
+        context=context,
+        background=background,
+    )
+    tool_spec = {
+        "name": name,
+        "description": description,
+        "inputSchema": {"json": schema},
+    }
+
+    def resolve(raw: Mapping[str, Any]) -> AgentSpec:
+        # The schema has no name field; the child takes the tool's name.
+        model_input: list[Mapping[str, Any]] = [{**raw, "name": name}]
+        return _resolve_specs(
+            model_input,
+            presets=presets,
+            default_preset=default_preset,
+            instructions=instructions,
+            tools=tools,
+            model=model,
+        )[0]
+
+    return _SubagentTool(
+        name,
+        tool_spec,
+        resolve,
+        context,
+        builder,
+        max_depth,
+        background=background,
+        stall_timeout=stall_timeout,
+        max_consecutive_errors=max_consecutive_errors,
+    )
+
+
+subagent = make_subagent()
+"""Pre-built subagent tool with default settings (generalist preset, all axes using defaults)."""
